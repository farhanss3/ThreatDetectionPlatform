<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.palisade.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/opt/palisade/palisade_agent.py</string>
    <string>--server</string><string>http://CHANGE-ME:8787</string>
    <string>--state</string><string>/var/db/palisade/state.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/palisade-agent.log</string>
  <key>StandardErrorPath</key><string>/var/log/palisade-agent.log</string>
</dict>
</plist>
