  "id": "TDP-LIB-T1547-001-RUNKEY-MOD",
  "title": "Suspicious registry Run key modification",
  "status": "draft",
  "severity": "medium",
  "description": "Detects changes to user or machine Run keys often used for persistence.",
  "query": {
    "language": "sigma",
    "expression": "selection: TargetObject|contains: ['\\Software\\Microsoft\\Windows\\CurrentVersion\\Run','\\Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce'] and EventType: 'SetValue'"
